# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
DOMAIN=staging.gas365.pk
IMAGE_REGISTRY=ghcr.io/waqarahmedkhan96
IMAGE_TAG=replace-with-commit-sha
ASPNETCORE_ENVIRONMENT=Production

POSTGRES_DB=gas365
POSTGRES_USER=gas365
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@gas365.pk

# Comma-separated platform administrator emails.
PLATFORM_ADMIN_EMAILS=

# Off-site backup destination: any rclone remote, e.g. "offsite:gas365-backups". Leave empty to keep local copies only.
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=30
# Optional heartbeat URL pinged after successful backups (e.g. a healthchecks.io check).
BACKUP_HEARTBEAT_URL=
